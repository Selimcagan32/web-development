    {
      "name": "16 Yaklaşan etkinlikler",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/events/upcoming",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "events",
            "upcoming"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ms = (t) => { const [g, a, y] = t.split(\"-\").map(Number); return Date.UTC(y, a - 1, g); };",
              "const s = new Date(); const bugun = Date.UTC(s.getUTCFullYear(), s.getUTCMonth(), s.getUTCDate());",
              "const liste = pm.response.json();",
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"geçmiş tarihli yok\", () => liste.forEach((e) => pm.expect(ms(e.date)).to.be.at.least(bugun)));",
              "pm.test(\"en yakın önce\", () => liste.forEach((e, i) => i && pm.expect(ms(e.date)).to.be.at.least(ms(liste[i - 1].date))));",
              "pm.test(\"seed'deki geçmiş etkinlikler elendi\", () => pm.expect(liste.length).to.be.below(Number(pm.collectionVariables.get(\"toplam\")) + 1));"
            ]
          }
        }
      ]
