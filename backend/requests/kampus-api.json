      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));",
              "pm.test(\"student dolu\", () => pm.expect(String(pm.response.json().student)).to.match(/\\d{6,}/));"
            ]
          }
        }
      ]
    },
