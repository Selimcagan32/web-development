            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const liste = pm.response.json();",
              "pm.test(\"en az 6 kayıt\", () => pm.expect(liste.length).to.be.at.least(6));",
              "pm.test(\"tarihler GG-AA-YYYY\", () => liste.forEach((e) => pm.expect(e.date).to.match(/^\\d{2}-\\d{2}-\\d{4}$/)));",
              "pm.test(\"_id ve createdAt var\", () => { pm.expect(liste[0]).to.have.property(\"_id\"); pm.expect(liste[0]).to.have.property(\"createdAt\"); });",
              "pm.collectionVariables.set(\"eventId\", liste[0]._id);",
              "pm.collectionVariables.set(\"toplam\", liste.length);"
            ]
          }
        }
      ]
    },
